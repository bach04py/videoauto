.venv/
.index/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
# footage never goes in the repo (camera files are often upper-case .MP4); the test clips
# made by tests/fixtures/make_fixtures.py (ffmpeg test patterns) are the exception, below
tests/fixtures/*
*.[mM][pP]4
*.[mM][oO][vV]
*.[mM][kK][vV]
*.[mM][tT][sS]
!openchatcut/*.mts
catalogue.json
# your brand assets and scripts stay local (see README, config.yaml)
brand/
scripts/
.occ-data/
output/
plan.json
# python -m videoauto.watch: folders chosen on this machine
videoauto.local.yaml
*.tmp
previews/
# the setup check clip (made by us with ffmpeg testsrc2, no third-party media)
!videoauto/assets/*.mp4
# synthetic test clips (ffmpeg testsrc2), committed so a fresh clone runs the whole suite
!tests/fixtures/make_fixtures.py
!tests/fixtures/gym.mp4
!tests/fixtures/sunset.mp4
